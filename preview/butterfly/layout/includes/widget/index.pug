aside#aside-content.aside-content
  if globalPageType === 'post'
    if showToc
      .sticky_layout
        include ./card_post_toc.pug
  else
    section.card-widget.ph-author(aria-labelledby='author-name')
      .ph-author-top
        img(src=url_for(theme.avatar.img) alt='Phoenix 的头像' width='96' height='96')
        h2#author-name= config.author
      p.ph-author-signature 唯有热爱可抵岁月漫长
      nav.ph-author-stats(aria-label='博客统计')
        a(href=url_for('/archives/'))
          span 文章
          strong= site.posts.length
        a(href=url_for('/tags/'))
          span 标签
          strong= site.tags.length
        a(href=url_for('/categories/'))
          span 分类
          strong= site.categories.length
      a.ph-author-follow(href='https://github.com/Phoenix500526' aria-label='在 GitHub 关注 Phoenix')
        i.fab.fa-github(aria-hidden='true')
        | Follow Me
      .ph-author-links
        a(href='https://github.com/Phoenix500526' aria-label='Phoenix 的 GitHub' title='GitHub')
          i.fab.fa-github(aria-hidden='true')
        a(href='mailto:Phoenix500526@163.com' aria-label='发送邮件给 Phoenix' title='Phoenix500526@163.com')
          i.fas.fa-envelope(aria-hidden='true')
        a(href='https://twitter.com/Lancelo92664230' aria-label='Phoenix 的推特' title='Twitter / X')
          i.fab.fa-twitter(aria-hidden='true')
        a(href=url_for('/atom.xml') aria-label='RSS 订阅' title='RSS 订阅')
          i.fas.fa-rss(aria-hidden='true')
    section.card-widget.ph-topics
      h2 源码阅读
      p.ph-widget-note 沿着实现，理解设计
      each topic in ph_topics().filter(topic => topic.series)
        a.ph-topic(href=url_for(topic.path))
          div
            strong= topic.label
            small= topic.description
          span= String(topic.count).padStart(2, '0')
      h2.ph-topic-subtitle 其他主题
      each topic in ph_topics().filter(topic => !topic.series)
        a.ph-topic.ph-topic-small(href=url_for(topic.path))
          strong= topic.label
          span= String(topic.count).padStart(2, '0')
    section.card-widget.ph-tags
      h2 常用标签
      .ph-tag-list
        each tag in site.tags.sort('length', -1).limit(10).data
          a(href=url_for(tag.path))= tag.name
    section.card-widget.ph-webinfo(aria-labelledby='website-info-title')
      h2#website-info-title
        i.fas.fa-chart-line(aria-hidden='true')
        | 网站信息
      dl
        div
          dt 文章总数
          dd= site.posts.length
        div
          dt 全站字数
          dd= totalcount(site)
        div
          dt 访客数
          dd(id=theme.busuanzi.site_uv ? 'busuanzi_value_site_uv' : undefined)= theme.busuanzi.site_uv ? '加载中…' : '本地不统计'
        div
          dt 总浏览量
          dd(id=theme.busuanzi.site_pv ? 'busuanzi_value_site_pv' : undefined)= theme.busuanzi.site_pv ? '加载中…' : '本地不统计'
        - const latestPost = site.posts.sort('updated', -1).first()
        if latestPost
          div
            dt 最近内容更新
            dd
              time(datetime=date_xml(latestPost.updated) title='最近一次文章发布或内容更新')= date(latestPost.updated, 'YYYY-MM-DD')
