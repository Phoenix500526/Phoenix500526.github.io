extends includes/layout.pug

block content
  - const series = ph_series(page)
  #post.ph-article
    nav.ph-breadcrumb(aria-label='当前位置')
      a(href=url_for('/')) 首页
      span(aria-hidden='true') /
      each category in page.categories.data
        a(href=url_for(category.path))= category.name
    header.ph-article-header
      h1.post-title= page.title
      .ph-post-meta
        span= config.author
        time(datetime=date_xml(page.date))= date(page.date, 'YYYY-MM-DD')
        each tag in page.tags.data.slice(0, 3)
          a(href=url_for(tag.path))= tag.name
      if series
        a.ph-series-entry(href='#series-reading')
          span= '所属系列 · ' + series.label + ' 源码阅读'
          span= '查看全部 ' + series.posts.length + ' 篇 ↓'
      if showToc
        button.ph-mobile-toc(type='button' aria-controls='card-toc' aria-expanded='false') 本文目录 #[span(aria-hidden='true') ☰]
    article#article-container.container.post-content!= page.content
    if series
      nav#series-reading.ph-series-reading(aria-label='本系列文章')
        .ph-section-label
          h2= series.label + ' · 继续阅读'
          a(href=url_for(series.path))= '全部 ' + series.posts.length + ' 篇 ↗'
        ol
          each post in series.posts
            li(class=post.path === page.path ? 'is-current' : '')
              if post.path === page.path
                span(aria-current='page')= post.title
                small 正在阅读
              else
                a(href=url_for(post.path))= post.title
    else
      - const related = ph_related(page)
      if related.length
        nav.ph-series-reading(aria-label='相关笔记')
          .ph-section-label
            h2 继续探索
          ul
            each post in related
              li
                a(href=url_for(post.path))= post.title
    footer.ph-article-footer
      .ph-tag-list
        each tag in page.tags.data
          a(href=url_for(tag.path))= tag.name
      p= '作者：' + config.author + ' · 转载请注明作者与原文链接。'
      a.ph-text-link(href=url_for('/')) ← 返回首页

  include includes/city-walk.pug
